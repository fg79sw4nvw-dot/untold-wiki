{
  "schemaVersion": 1,
  "registryRevision": 2,
  "updatedAt": "2026-09-15",
  "purpose": "Machine-readable registry of cross-cutting decision criteria for UNTOLD. The rule text remains canonical in the referenced Markdown source; this registry gives each criterion a stable id, scope, and retroactive behavior.",
  "statusSemantics": {
    "confirmed": "Current criterion and usable for design/review.",
    "provisional": "May be used only as provisional guidance and must not silently override confirmed specifications.",
    "retired": "Historical only; do not apply to current work."
  },
  "retroactiveModes": {
    "apply": "Review all matching existing current specifications and revise conflicting content as part of the same explicitly authorized criterion change. Record every changed path in governance/review-ledger.json.",
    "review": "Review all matching existing current specifications, report conflicts, and record the review. Do not change substantive confirmed game content without an explicit follow-up decision.",
    "future_only": "Apply only to new or newly changed content. Existing content is not automatically reinterpreted."
  },
  "defaultRetroactiveModeForNewCriteria": "review",
  "scopeProfiles": {
    "all-current-spec": {
      "includePrefixes": ["pages/"],
      "excludePaths": [
        "pages/development/implementation-status.md",
        "pages/development/eld-playthrough-goal.md",
        "pages/world/world-regions-routes.md",
        "pages/governance/spec-maintenance.md"
      ],
      "notes": "Current design/specification pages. Progress, retired milestones, legacy history and governance documentation are excluded."
    },
    "narrative-design": {
      "includePrefixes": ["pages/story/"],
      "includePaths": [
        "pages/design-philosophy.md",
        "pages/systems/events.md",
        "pages/world/eld-npcs.md",
        "pages/development/eld-opening-sequence.md",
        "pages/development/day2-home-tutorial.md"
      ],
      "notes": "Story, dialogue, character reaction, event presentation and narrative-facing content."
    },
    "place-narrative-design": {
      "includePrefixes": ["pages/world/"],
      "includePaths": [
        "pages/story/narrative-world-design.md",
        "pages/systems/facilities.md",
        "pages/systems/encounters.md"
      ],
      "notes": "Terrain, town, settlement, dungeon, ruin, facility and other place-design work. Apply these criteria to the narrative-facing parts of a place rather than mechanically to pure coordinate or collision data. If a dedicated dungeon directory is added later, extend this scope."
    },
    "naming-bearing-content": {
      "includePrefixes": ["pages/world/", "pages/story/", "pages/cards/"],
      "includePaths": [
        "pages/systems/cards.md",
        "pages/systems/spells.md",
        "pages/systems/economy.md",
        "pages/systems/encounters.md",
        "pages/systems/free-pocket.md"
      ],
      "notes": "Pages likely to introduce or depend on proper names. Apply a naming criterion only to naming-bearing fragments, not mechanically to every sentence in these files."
    },
    "foreshadowing-content": {
      "includePaths": [
        "pages/story/foreshadowing-ledger.md",
        "pages/story/protagonist.md",
        "pages/story/gamemaster.md",
        "pages/story/narrative-world-design.md",
        "pages/design-philosophy.md",
        "pages/development/eld-opening-sequence.md",
        "pages/world/eld-npcs.md"
      ],
      "includePrefixes": ["pages/cards/"],
      "notes": "Content that can deliberately imply hidden truths, unresolved truths or future reveals."
    }
  },
