  "updateRules": {
    "confirmedDecision": "Write it to the topic-specific canonical page. Also review open-items, indexes, aliases and related references.",
    "newOrRemovedPublicPage": "Update pages.json.",
    "existingPageBodyChange": "Update the Markdown source only; do not synchronize wiki.json.",
    "legacyMaterial": "Keep it clearly marked as legacy/history and never silently promote it to current specification.",
    "batching": "As a normal conversation workflow, batch GitHub specification updates after roughly 10 confirmed items, or earlier at a topic boundary, conversation end, or explicit update request.",
    "implementationState": "When the user asks what is actually implemented now, verify fg79sw4nvw-dot/untold-game when needed."
  }
