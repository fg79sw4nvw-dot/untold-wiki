    "supporting summaries and indexes",
    "implementation status or implementation handoff summaries",
    "legacy, history, compatibility material"
  ],
  "statusSemantics": {
    "確定": "usable as current confirmed specification",
    "暫定": "usable only as provisional specification and must be described as provisional",
    "案": "not adopted",
    "候補": "not adopted",
    "未確定": "not adopted; do not fill in by inference",
    "廃止": "not current specification",
    "旧": "history or compatibility only"
  },
